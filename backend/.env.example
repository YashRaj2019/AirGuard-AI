# ==============================================================================
# AirGuard AI — Spring Boot Backend Environment Configuration Template
# Copy this file to .env and adjust credentials for your environment.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=airguard_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Python Machine Learning Microservice Connection
ML_SERVICE_URL=http://localhost:8000

# Optional Generative AI Integration (Gemini)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
