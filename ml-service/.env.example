# AirGuard AI Python FastAPI Backend Environment Template
# Copy this file to .env and configure your local/cloud database credentials

PORT=8000
HOST=0.0.0.0

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=airguard_db

# Security & Session Secrets
JWT_SECRET_KEY=change_this_to_a_secure_random_string_for_production
ENVIRONMENT=production
