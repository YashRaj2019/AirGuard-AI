# ==============================================================================
# AirGuard AI — Environment Configuration Template
# Copy this file to .env and customize values for your local environment.
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=airguard_db

# Unified Python FastAPI Backend
PORT=8000
HOST=0.0.0.0
JWT_SECRET_KEY=your_secure_jwt_secret_token_here

# Generative AI Configuration
# Optional: Set your Gemini or OpenAI API key.
# If left blank, the application automatically uses the built-in domain-aware expert advisory engine.
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME="AirGuard AI"
